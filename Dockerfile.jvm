FROM registry.access.redhat.com/ubi9/openjdk-17-runtime:1.24

USER 0
ENV HOME=/work \
    ILI_CACHE=/tmp/gb2av/.ilicache \
    LOG4J_FORMAT_MSG_NO_LOOKUPS=true
WORKDIR /work

COPY --chown=0:0 --chmod=0444 build/libs/gb2av-*-exec.jar ./application.jar

USER 1001:0
EXPOSE 8080

CMD ["java", "-XX:MaxRAMPercentage=80.0", "-XX:-UseBASE64Intrinsics", "-jar", "application.jar"]
